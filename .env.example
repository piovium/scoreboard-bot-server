# Server
PORT=3000
LOG_LEVEL=info

# miHoYo passport API (QR login + status polling)
PASSPORT_API_URL=https://passport-api.mihoyo.com

# miHoYo biz API (data query after login)
BIZ_API_URL=https://api-takumi.mihoyo.com

# miHoYo game API (game data queries)
GAME_API_URL=https://hk4e-api.mihoyo.com

# RPC headers for device fingerprinting
RPC_APP_ID=cie2gjc0sg00
RPC_CLIENT_TYPE=4
RPC_GAME_BIZ=hk4e_cn
RPC_SDK_VERSION=2.53.1

# Device info defaults
DEVICE_NAME=Chrome
DEVICE_MODEL=Chrome 149.0.0.0
DEVICE_OS=Windows 10 64-bit

# Redis
REDIS_URL=redis://localhost:6379/0

# Puppeteer / Chromium
# Remote mode (Docker): set CHROMIUM_WS_ENDPOINT
# CHROMIUM_WS_ENDPOINT=ws://localhost:9222/devtools/browser
# Local mode (default): leave empty to auto-launch installed Chrome
CHROMIUM_WS_ENDPOINT=
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Session TTL (seconds)
SESSION_TTL=300
# Cookie TTL (seconds). Default -1 means never expire.
# COOKIE_TTL=-1
